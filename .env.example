# Copie para .env e ajuste. Nunca versione o .env.
ONEGATE_DATABASE_URL=postgres://onegate:onegate@localhost:5432/onegate?sslmode=disable
# openssl rand -base64 32
ONEGATE_SECRET_KEY=
ONEGATE_LISTEN=:8080
# Só em desenvolvimento local sem HTTPS:
ONEGATE_INSECURE_COOKIES=1
# Testes de integração (o esquema deste banco é apagado a cada execução):
ONEGATE_TEST_DATABASE_URL=postgres://onegate:onegate@localhost:5432/onegate_test?sslmode=disable
